<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Roman Scroll (Centered & Scaled) -->
    <!-- Parchment with shading -->
    <path android:pathData="M32,33 h44 v42 h-44 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="54"
                android:endX="76"
                android:endY="54"
                android:type="linear">
                <item android:offset="0" android:color="#E0D7C1" />
                <item android:offset="0.1" android:color="#FDF5E6" />
                <item android:offset="0.9" android:color="#FDF5E6" />
                <item android:offset="1" android:color="#D6CCB0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Roller (Cylindrical) -->
    <path android:pathData="M29,27 h50 v6 q-25,1.5 -50,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="27"
                android:endX="54"
                android:endY="33"
                android:type="linear">
                <item android:offset="0" android:color="#A68D60" />
                <item android:offset="0.5" android:color="#E1C16E" />
                <item android:offset="1" android:color="#8C734D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom Roller (Cylindrical) -->
    <path android:pathData="M29,75 h50 v6 q-25,-1.5 -50,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="75"
                android:endX="54"
                android:endY="81"
                android:type="linear">
                <item android:offset="0" android:color="#A68D60" />
                <item android:offset="0.5" android:color="#E1C16E" />
                <item android:offset="1" android:color="#8C734D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Scroll "Writing" (Subtle lines) -->
    <path
        android:fillAlpha="0.6"
        android:fillColor="#5D4037"
        android:pathData="M39,43 h30 v1.5 h-30 z M39,51 h30 v1.5 h-30 z M39,59 h30 v1.5 h-30 z M39,67 h18 v1.5 h-18 z" />

</vector>
